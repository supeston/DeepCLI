# ==============================================================================
# DEEPX AGENT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or deepx/core/.env) and fill in your API tokens.
#
# NOTE: DeepSeek web automation uses chat.deepseek.com browser session (state.json),
# so no DeepSeek API key is needed. The keys below are only for OSINT tools.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Funstat / Telelog OSINT (Telegram Intelligence)
# ------------------------------------------------------------------------------
# Token for querying Telegram user stats, reputation, and message counts.
# Get token at: https://telelog.org or https://t.me/funstat_bot
FUNSTAT_API_TOKEN=your_funstat_api_token_here

# ------------------------------------------------------------------------------
# 2. DaData OSINT (Russian Registry & Entity Intelligence)
# ------------------------------------------------------------------------------
# API keys for company registry (FTS/EGRUL), banks (BIC/SWIFT), addresses, etc.
# Register at: https://dadata.ru
DADATA_API_KEY=your_dadata_api_key_here
DADATA_SECRET_KEY=your_dadata_secret_key_here

# Allow paid DaData operations (clean_address, clean_fio, clean_phone, etc.)
# Set to 'true' only if you have paid balance on DaData. Default: false
DADATA_ALLOW_PAID=false

# ------------------------------------------------------------------------------
# 3. VDS / Remote Server Deployment (Optional Default Credentials)
# ------------------------------------------------------------------------------
# You can set default VDS credentials here, or save named profiles via
# tool action 'save_profile' (stored in .deepx/vds_profiles.json).
VDS_HOST=
VDS_USER=root
VDS_PORT=22
VDS_PASSWORD=
VDS_KEY_PATH=

